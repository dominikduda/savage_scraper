{
  "manifest_version": 3,
  "name": "Savage Scraper",
  "version": "1.2.2",
  "description": "Scrapes rendered pages into simplified LLM-friendly HTML for clipboard or optional local MCP workflows.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite",
    "alarms"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Savage Scraper",
    "default_popup": "popup.html"
  }
}
