{
  "manifest_version": 3,
  "name": "Savage Scraper",
  "version": "1.0.3",
  "description": "Scrapes a simplified representation of the current page and copies it to the clipboard.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite"
  ],
  "action": {
    "default_title": "Savage Scraper",
    "default_popup": "popup.html"
  }
}
